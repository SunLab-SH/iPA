# Data (download from Zenodo)
data/*
!data/.gitkeep

# History and Development Files
history/
data_history/
documentations/

# Models (managed via Git LFS)
# *.pth files are tracked by LFS, but we ignore any loose model folders just in case
ipa/processing/*/models/*.pth
ipa/processing/denoising/models/*.pth
ipa/processing/segmentation/models/*.pth

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# IDE and AI Assistant Configurations
.vscode/
.idea/
.lingma/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
.ipynb_checkpoints/

# Development scripts
test_*.py
debug_*.py
compress_*.py
fast_*.py
run_*.ps1
run_*.sh

# Temporary outputs
cryoet_filament_output/
sxt_isg_real_output/
sim_er_training_demo/
sxt_*_training_demo/
test_dir/

# Data and model URLs configuration (contains private URLs)
data_urls.json
